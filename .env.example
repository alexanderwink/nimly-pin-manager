# Inside Docker, localhost is the container itself: use the broker host or service name
MQTT_URL=mqtt://homeassistant.local:1883
MQTT_USERNAME=
MQTT_PASSWORD=
Z2M_BASE_TOPIC=zigbee2mqtt
# Friendly name of the lock in zigbee2mqtt
LOCK_NAME=front_door
PORT=3000
HOST=0.0.0.0
# Slots the app may assign. 000-002 are master slots on the lock and are never used.
# The keypad manual says 999, but over Zigbee the lock reports 50 PIN users (slots 0-49).
# LAST_SLOT is capped further if the lock reports fewer (num_pin_users).
FIRST_SLOT=3
LAST_SLOT=49
# Comma-separated slots inside the range that the app must never use
RESERVED_SLOTS=
DATA_FILE=data/users.json
CONFIRM_TIMEOUT_MS=15000
# Scheduling
SCHEDULE_LEAD_MINUTES=5
RETRY_MINUTES=5
OVERDUE_GRACE_MINUTES=2

# Debug: log every MQTT payload sent/received (PINs masked)
LOG_MQTT=0
